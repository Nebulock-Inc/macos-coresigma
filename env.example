# coreSigma Environment Configuration
#
# RECOMMENDED: Run ./scripts/setup_credentials.sh --sync-docker
# This automatically creates .env with your password and syncs to Keychain.
#
# SECURITY NOTE: Never commit .env to version control!
# The .gitignore file excludes it.

# ============================================================
# DOCKER COMPOSE PASSWORD
# ============================================================
# This password is used by docker-compose.yml for Elasticsearch and Kibana.
# Set via: ./scripts/setup_credentials.sh --sync-docker
#
ELASTIC_PASSWORD=changeme

# ============================================================
# OPTIONAL: Kibana Encryption Keys
# ============================================================
# Uncomment and set for production deployments:
# KIBANA_ENCRYPTION_KEY=your_32_char_key_here
# KIBANA_SECURITY_KEY=your_32_char_key_here
# KIBANA_REPORTING_KEY=your_32_char_key_here

# ============================================================
# COLLECTOR AUTHENTICATION (Alternative Methods)
# ============================================================
# The collectors support multiple auth methods (in priority order):
#
# 1. ES_API_KEY - API Key (recommended for production)
#    Create with: ./scripts/setup_credentials.sh --api-key
#    ES_API_KEY=your_base64_encoded_api_key
#
# 2. macOS Keychain - Automatic with --sync-docker
#    No env vars needed - collectors read from Keychain
#
# 3. ES_USER/ES_PASSWORD - Basic auth via environment
#    ES_USER=elastic
#    ES_PASSWORD=changeme
#
# 4. Config file: ~/.coresigma/config.yml

# ============================================================
# ELASTICSEARCH CONNECTION
# ============================================================
ES_URL=http://localhost:9200

# ============================================================
# KIBANA CONNECTION
# ============================================================
KIBANA_URL=http://localhost:5601

# ============================================================
# COLLECTOR SETTINGS
# ============================================================
# Enable/disable event filtering (reduces noise)
# ESF_FILTERING=true
# UL_FILTERING=true

# ============================================================
# ALTERNATIVE: Config File
# ============================================================
# Instead of environment variables, you can use:
# ~/.coresigma/config.yml
#
# Example config:
#   elasticsearch:
#     url: http://localhost:9200
#     api_key: "your_api_key"
#     # OR
#     username: elastic
#     password: changeme
