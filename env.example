# coreSigma Environment Configuration
# Copy this file to .env and set your values
# chmod 600 .env  # Restrict permissions

# =============================================================================
# Elasticsearch/Kibana Authentication
# =============================================================================

# Option 1: API Key (recommended for production)
# Create an API key in Kibana: Management > API Keys
# ES_API_KEY=your_base64_encoded_api_key

# Option 2: Basic Authentication
ES_USER=elastic
ES_PASSWORD=changeme

# =============================================================================
# Service URLs
# =============================================================================

# Elasticsearch URL
ELASTICSEARCH_URL=http://localhost:9200

# Kibana URL
KIBANA_URL=http://localhost:5601

# =============================================================================
# Index Configuration
# =============================================================================

# Index pattern for ESF events
ES_INDEX_ESF=macos-telemetry-esf-*

# Index pattern for UL events
ES_INDEX_UL=macos-telemetry-ul-*

# =============================================================================
# Collection Settings
# =============================================================================

# Enable/disable event filtering (true = less noise, false = all events)
ESF_ENABLE_FILTERING=true

# UL subsystems to monitor (comma-separated)
UL_SUBSYSTEMS=com.apple.TCC,com.apple.sudo,com.apple.gatekeeper,com.apple.syspolicy,com.apple.securityd,com.apple.alf,com.apple.opendirectoryd,com.apple.authorization
