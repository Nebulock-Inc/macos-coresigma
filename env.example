# coreSigma Environment Configuration
# Copy this file to .env and update values as needed
#
# SECURITY NOTE: Never commit .env to version control!
# The .gitignore file should already exclude it.

# ============================================================
# ELASTICSEARCH AUTHENTICATION
# ============================================================
# Choose ONE of these authentication methods:

# Option 1: API Key (RECOMMENDED for production)
# Create with: ./scripts/setup_credentials.sh --api-key
# ES_API_KEY=your_base64_encoded_api_key

# Option 2: Basic Auth (simple setup)
# ES_USER=elastic
# ES_PASSWORD=changeme

# Option 3: macOS Keychain (RECOMMENDED for local development)
# Run: ./scripts/setup_credentials.sh --password
# No environment variables needed - credentials are in Keychain

# ============================================================
# ELASTICSEARCH CONNECTION
# ============================================================
ES_URL=http://localhost:9200

# ============================================================
# KIBANA CONNECTION
# ============================================================
KIBANA_URL=http://localhost:5601

# ============================================================
# COLLECTOR SETTINGS
# ============================================================
# Enable/disable event filtering (reduces noise)
# ESF_FILTERING=true
# UL_FILTERING=true

# ============================================================
# ALTERNATIVE: Config File
# ============================================================
# Instead of environment variables, you can use:
# ~/.coresigma/config.yml
#
# Example config:
#   elasticsearch:
#     url: http://localhost:9200
#     api_key: "your_api_key"
#     # OR
#     username: elastic
#     password: changeme
